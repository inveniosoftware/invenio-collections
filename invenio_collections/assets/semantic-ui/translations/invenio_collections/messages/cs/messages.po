msgstr "Kolekce pro"

msgid "New collection"
msgstr "Nová kolekce"

msgid "Edit Category"
msgstr "Upravit kategorii"

msgid "Delete Category"
msgstr "Smazat kategorii"

msgid "No collections found for"
msgstr "Nebyly nalezeny žádné kolekce pro"

msgid "Edit section"
msgstr "Upravit sekci"

msgid "Delete section"
msgstr "Smazat sekci"

msgid "Saving order..."
msgstr "Ukládá se pořadí..."

