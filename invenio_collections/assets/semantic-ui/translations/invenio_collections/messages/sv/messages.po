msgid "Error"
msgstr "Fel"

msgid "This collection has child collections"
msgstr "Denna samling har underordnade samlingar"

msgid ""
"You must check the option below to delete this collection along with all its"
" child collections."
msgstr ""
"Du måste markera alternativet nedan för att radera denna samling tillsammans"
" med alla dess underordnade samlingar."

msgid "Delete this collection and all its children"
msgstr "Radera denna samling och alla dess underordnade samlingar"

msgid "Warning"
msgstr "Varning"

msgid ""
"This will permanently delete this collection and ALL of its child "
"collections. This action cannot be undone."
msgstr ""
"Detta kommer att permanent radera denna samling och ALLA dess underordnade "
"samlingar. Denna åtgärd kan inte ångras."

msgid "Cancel"
msgstr "Avbryt"

msgid "Delete"
msgstr "Radera"

msgid "This category contains collections"
msgstr "Denna kategori innehåller samlingar"

msgid ""
"You must check the option below to delete the category along with all its "
"collections."
msgstr ""
"Du måste markera alternativet nedan för att radera kategorin tillsammans med"
" alla dess samlingar."

msgid "Delete this category and all its collections"
msgstr "Radera denna kategori och alla dess samlingar"

msgid ""
"This will permanently delete this category and ALL of its collections. This "
"action cannot be undone."
msgstr ""
"Detta kommer att permanent radera denna kategori och ALLA dess samlingar. "
"Denna åtgärd kan inte ångras."

msgid "Failed to save new order. Please try again."
msgstr "Det gick inte att spara den nya ordningen. Försök igen."

msgid "Collections"
msgstr "Samlingar"

msgid "Collections must be organized into sections."
msgstr "Samlingar måste organiseras i sektioner."

msgid "New section"
msgstr "Ny sektion"

msgid "There are no sections."
msgstr "Det finns inga sektioner."

msgid "Edit"
msgstr "Redigera"

msgid "Add Child"
msgstr "Lägg till underordnad"

msgid "Collections for"
msgstr "Samlingar för"

msgid "New collection"
msgstr "Ny samling"

msgid "Edit Category"
msgstr "Redigera kategori"

msgid "Delete Category"
msgstr "Radera kategori"

msgid "No collections found for"
msgstr "Inga samlingar hittades för"

msgid "Edit section"
msgstr "Redigera sektion"

msgid "Delete section"
msgstr "Radera sektion"

msgid "Saving order..."
msgstr "Sparar ordning..."

msgid "Title is required"
msgstr "Titel krävs"

msgid "Maximum number of characters is 255"
msgstr "Maximalt antal tecken är 255"

msgid "Slug is required"
msgstr "Slug krävs"

msgid "Maximum number of characters is 100"
msgstr "Maximalt antal tecken är 100"

msgid "Search query is required"
msgstr "Sökfråga krävs"

msgid "Title"
msgstr "Titel"

msgid "Slug"
msgstr "Slug"

